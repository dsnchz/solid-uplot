{
  "name": "@dschz/solid-uplot",
  "version": "0.6.0",
  "description": "SolidJS wrapper for uPlot — ultra-fast, tiny time-series & charting library",
  "keywords": [
    "analytics",
    "canvas",
    "chart",
    "charts",
    "dashboard",
    "data-dashboard",
    "data-visualization",
    "data-viz",
    "fast",
    "financial-charts",
    "interactive-charts",
    "lightweight",
    "lightweight-charts",
    "metrics",
    "plotting",
    "plugin",
    "plugins",
    "real-time",
    "solid",
    "solid-chart",
    "solid-component",
    "solid-plugin",
    "solid-uplot",
    "solidjs",
    "solidjs-wrapper",
    "streaming-data",
    "time-series",
    "timeseries",
    "typescript",
    "uplot",
    "uplot-solid",
    "visualization"
  ],
  "homepage": "https://github.com/dsnchz/solid-uplot#readme",
  "bugs": {
    "url": "https://github.com/dsnchz/solid-uplot/issues"
  },
  "license": "MIT",
  "author": "Daniel Sanchez <dsanc89@pm.me>",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsnchz/solid-uplot.git",
    "directory": "packages/solid-uplot"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index/index.js",
  "module": "./dist/index/index.js",
  "browser": {},
  "types": "./dist/index/index.d.ts",
  "typesVersions": {
    "*": {
      "plugins": [
        "./dist/plugins/index.d.ts"
      ],
      "utils": [
        "./dist/utils/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index/index.d.ts",
        "default": "./dist/index/index.js"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins/index.d.ts",
        "default": "./dist/plugins/index.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dschz/tsconfig": "workspace:*",
    "@napi-rs/canvas": "1.2.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/user-event": "14.6.13",
    "@types/bun": "1.4.5",
    "@vitest/coverage-istanbul": "5.1.1",
    "@wessberg/pointer-events": "^1.0.9",
    "jsdom": "31.0.1",
    "solid-js": "1.9.14",
    "tsup": "8.5.1",
    "tsup-preset-solid": "2.2.0",
    "typescript": "6.0.3",
    "uplot": "^1.6.32",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.17",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "solid-js": ">=1.6.0",
    "uplot": ">=1.6.32"
  }
}
