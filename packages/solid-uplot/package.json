{
  "name": "@dschz/solid-uplot",
  "version": "0.5.0",
  "description": "SolidJS wrapper for uPlot — ultra-fast, tiny time-series & charting library",
  "type": "module",
  "author": "Daniel Sanchez <dsanc89@pm.me>",
  "license": "MIT",
  "keywords": [
    "analytics",
    "canvas",
    "chart",
    "charts",
    "dashboard",
    "data-dashboard",
    "data-visualization",
    "data-viz",
    "fast",
    "financial-charts",
    "interactive-charts",
    "lightweight",
    "lightweight-charts",
    "metrics",
    "plugin",
    "plugins",
    "plotting",
    "real-time",
    "solid",
    "solid-chart",
    "solid-component",
    "solid-plugin",
    "solid-uplot",
    "solidjs",
    "solidjs-wrapper",
    "streaming-data",
    "time-series",
    "timeseries",
    "typescript",
    "uplot",
    "uplot-solid",
    "visualization"
  ],
  "homepage": "https://github.com/dsnchz/solid-uplot#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsnchz/solid-uplot.git",
    "directory": "packages/solid-uplot"
  },
  "bugs": {
    "url": "https://github.com/dsnchz/solid-uplot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index/index.js",
  "module": "./dist/index/index.js",
  "types": "./dist/index/index.d.ts",
  "browser": {},
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index/index.d.ts",
        "default": "./dist/index/index.js"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins/index.d.ts",
        "default": "./dist/plugins/index.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "plugins": [
        "./dist/plugins/index.d.ts"
      ],
      "utils": [
        "./dist/utils/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "solid-js": ">=1.6.0",
    "uplot": ">=1.6.32"
  },
  "devDependencies": {
    "@dschz/tsconfig": "workspace:*",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.3",
    "@vitest/coverage-istanbul": "^4.0.13",
    "@wessberg/pointer-events": "^1.0.9",
    "canvas": "^3.2.0",
    "jsdom": "^27.2.0",
    "path2d": "^0.3.1",
    "solid-js": "^1.9.10",
    "tsup": "^8.5.1",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^5.9.3",
    "uplot": "^1.6.32",
    "vite": "^7.2.4",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.13"
  }
}
